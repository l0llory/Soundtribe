<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.soundtribe.ExploreConcertController"
            stylesheets="@css/style.css"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15.0" right="15.0" bottom="10.0" left="15.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <HBox spacing="5.0" alignment="CENTER_LEFT">
                        <children>
                            <Button fx:id="precP_Concert" text="◀" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                            <Button fx:id="nextP_Concert" text="▶" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                            <Button fx:id="backHome_Concert" text="🏠" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                        </children>
                    </HBox>
                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="SoundTribe" styleClass="st-label-title">
                                <font><Font name="System Bold" size="22.0"/></font>
                            </Label>
                            <Label text="Dettaglio Concerto" styleClass="st-label-subtitle">
                                <font><Font size="11.0"/></font>
                            </Label>
                        </children>
                        <HBox.margin><Insets left="15.0"/></HBox.margin>
                    </VBox>
                    <Button fx:id="Exit_Concert" text="Esci" minWidth="70.0" minHeight="30.0" styleClass="st-button-outline"/>
                </children>
            </HBox>
            <Separator styleClass="st-separator"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" styleClass="st-scroll-pane">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="10.0" right="30.0" bottom="30.0" left="30.0"/>
                    </padding>

                    <HBox spacing="20.0" alignment="CENTER_LEFT">

                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="100.0" minWidth="100.0" minHeight="100.0"
                              style="-fx-background-color: #f3e5f5; -fx-background-radius: 10; -fx-border-color: #8a2be2; -fx-border-radius: 10;">
                            <children>
                                <Label text="🎸" textFill="#8a2be2">
                                    <font><Font size="48.0"/></font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="concertTitleLabel" text="Titolo del Concerto" styleClass="st-label-blue" wrapText="true">
                                <font><Font name="System Bold" size="28.0"/></font>
                            </Label>

                            <Label fx:id="concertArtistLabel" text="Artista Principale: ..." styleClass="st-label">
                                <font><Font size="18.0"/></font>
                            </Label>

                            <Label fx:id="uploaderLabel" text="Caricato da: ..." styleClass="st-label-subtitle">
                                <font><Font size="13.0" name="System Italic"/></font>
                            </Label>

                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                <Label text="EVENTO LIVE" style="-fx-background-color: #8a2be2; -fx-text-fill: white; -fx-padding: 2 6; -fx-background-radius: 4; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <Label fx:id="concertDateLabel" text="YYYY-MM-DD" styleClass="st-label-subtitle">
                                    <font><Font size="14.0"/></font>
                                </Label>
                                <Label text="|" styleClass="st-label-subtitle"/>
                                <Label fx:id="concertLocationLabel" text="Luogo" styleClass="st-label-subtitle"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <Separator styleClass="st-separator"/>

                    <VBox spacing="5.0" styleClass="st-card">
                        <Label text="Scaletta e Note" styleClass="st-label-blue">
                            <font><Font name="System Bold" size="14.0"/></font>
                        </Label>
                        <TextArea fx:id="descriptionArea" editable="false" wrapText="true" prefRowCount="6"
                                  styleClass="st-text-area" style="-fx-background-color: transparent;"/>
                    </VBox>

                    <Label text="Video del Concerto" styleClass="st-label-blue">
                        <font><Font name="System Bold" size="18.0"/></font>
                    </Label>

                    <VBox fx:id="linkContainer" spacing="10.0" styleClass="st-card">
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Label text="📺" style="-fx-font-size: 24px;"/>
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Guarda su YouTube" styleClass="st-label"/>
                                <Label fx:id="linkLabel" text="https://youtube.com/..." styleClass="st-label-subtitle" style="-fx-font-size: 10px;"/>
                            </VBox>
                            <Button fx:id="openLinkBtn" text="Apri Video" styleClass="st-button-primary"/>
                        </HBox>
                    </VBox>

                    <Separator styleClass="st-separator"/>

                    <VBox spacing="10.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Commenti" styleClass="st-label-blue">
                                <font><Font name="System Bold" size="18.0"/></font>
                            </Label>
                        </HBox>

                        <HBox spacing="10.0" alignment="TOP_CENTER">
                            <TextArea fx:id="newCommentArea" promptText="Scrivi un commento sul concerto..."
                                      prefRowCount="2" wrapText="true" HBox.hgrow="ALWAYS" styleClass="st-text-area"/>
                            <Button fx:id="btnPostComment" text="Invia" minHeight="50.0" minWidth="60.0" styleClass="st-button-primary"/>
                        </HBox>

                        <VBox fx:id="commentsContainer" spacing="15.0">
                            <Label text="Funzionalità commenti per concerti in arrivo..." styleClass="st-label-subtitle" style="-fx-font-style: italic;"/>
                        </VBox>
                    </VBox>

                    <Region minHeight="30.0"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>