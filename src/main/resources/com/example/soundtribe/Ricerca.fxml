<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.soundtribe.SearchController"
            prefHeight="600.0" prefWidth="800.0">

    <!-- HEADER SECTION -->
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15.0" right="15.0" bottom="10.0" left="15.0"/>
            </padding>

            <!-- Navigation Bar -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <!-- Navigation Buttons -->
                    <HBox spacing="5.0" alignment="CENTER_LEFT">
                        <children>
                            <Button fx:id="precP_Search" text="◀" minWidth="40.0" minHeight="30.0"/>
                            <Button fx:id="nextP_Search" text="▶" minWidth="40.0" minHeight="30.0"/>
                            <Button fx:id="backHome_Search" text="🏠" minWidth="40.0" minHeight="30.0"/>
                        </children>
                    </HBox>

                    <!-- Title Section -->
                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="SoundTribe" textFill="#3969da">
                                <font>
                                    <Font name="System Bold" size="22.0"/>
                                </font>
                            </Label>
                            <Label text="Gestione collezione musicale" textFill="#908888">
                                <font>
                                    <Font size="11.0"/>
                                </font>
                            </Label>
                        </children>
                        <HBox.margin>
                            <Insets left="15.0"/>
                        </HBox.margin>
                    </VBox>

                    <!-- Exit Button -->
                    <Button fx:id="Exit_Search" text="Esci" minWidth="70.0" minHeight="30.0">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </Button>
                </children>
            </HBox>

            <!-- Section Header -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets top="8.0" bottom="5.0"/>
                </padding>
                <children>
                    <Label text="Ricerca Avanzata" textFill="#3969da">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnFiltriAvanzati" text="▽ Filtri Avanzati" minWidth="130.0" minHeight="32.0">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </Button>
                </children>
            </HBox>

            <!-- Filters Section (Simile a Gestione Utenti) -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="5.0"/>
                </padding>
                <children>
                    <TextField fx:id="searchBar" promptText="Cerca brani, utenti, commenti..."
                               prefWidth="350.0" minHeight="30.0" HBox.hgrow="ALWAYS">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </TextField>
                    <ComboBox fx:id="categoryFilter" promptText="Tutte le categorie" prefWidth="150.0" minHeight="30.0">
                        <padding>
                            <Insets top="2.0" bottom="2.0"/>
                        </padding>
                    </ComboBox>
                    <ComboBox fx:id="sortBy" promptText="Ordina per" prefWidth="150.0" minHeight="30.0">
                        <padding>
                            <Insets top="2.0" bottom="2.0"/>
                        </padding>
                    </ComboBox>
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENT SECTION -->
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <!-- Results Count -->
            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label fx:id="resultsCountLabel" text="Risultati della ricerca" textFill="#908888">
                        <font>
                            <Font size="13.0"/>
                        </font>
                        <VBox.margin>
                            <Insets bottom="3.0"/>
                        </VBox.margin>
                    </Label>
                </children>
            </HBox>

            <!-- Results List Section -->
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <children>
                    <ListView fx:id="resultsList" VBox.vgrow="ALWAYS"/>
                </children>
            </VBox>
        </VBox>
    </center>

</BorderPane>
