<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.soundtribe.controller.ExploreExecutionController"
            stylesheets="@../css/style.css"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20.0" right="25.0" bottom="10.0" left="25.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <HBox spacing="5.0" alignment="CENTER_LEFT">
                  <Button fx:id="precP_Exec" text="◀" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                  <Button fx:id="nextP_Exec" text="▶" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                  <Button fx:id="backHome_Exec" text="🏠" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
               </HBox>
               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../img/soundtribe-logo.png" /></image>
                  </ImageView>
                  <VBox spacing="0.0" alignment="CENTER_LEFT">
                     <Label text="SoundTribe" styleClass="st-label-title">
                        <font><Font name="System Bold" size="26.0"/></font>
                     </Label>
                     <Label text="Gestione collezione musicale" styleClass="st-label-subtitle">
                        <font><Font size="12.0"/></font>
                     </Label>
                  </VBox>
               </HBox>
               <Region HBox.hgrow="ALWAYS"/>
               <Button fx:id="Exit_Exec" text="Esci" styleClass="st-button-outline" style="-fx-border-color: transparent;">
                  <graphic>
                     <Label text="🚪" style="-fx-text-fill: -st-blue-primary; -fx-font-size: 16px;"/>
                  </graphic>
               </Button>
            </HBox>
            <Separator styleClass="st-separator"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" styleClass="st-scroll-pane">
            <content>
                <VBox spacing="20.0" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="10.0" right="30.0" bottom="30.0" left="30.0"/>
                    </padding>

                    <HBox spacing="20.0" alignment="CENTER_LEFT">
                        <VBox alignment="CENTER" spacing="4.0" prefHeight="120.0" prefWidth="120.0" minWidth="120.0" minHeight="120.0"
                              style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #da3969, #8a1a3f); -fx-background-radius: 18; -fx-border-color: #f09ab2; -fx-border-width: 1.5; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, #da3969, 16, 0.3, 0, 4);">
                            <children>
                                <Label text="🎤" style="-fx-font-size: 54px;"/>
                                <Label text="LIVE" style="-fx-text-fill: #ffc8d8; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="titleLabel" text="Titolo Esecuzione" styleClass="st-label-blue" wrapText="true">
                                <font><Font name="System Bold" size="28.0"/></font>
                            </Label>

                            <Label fx:id="executorsLabel" text="Esecutori: ..." styleClass="st-label">
                                <font><Font size="18.0"/></font>
                            </Label>

                            <Label fx:id="uploaderLabel" text="Caricato da: ..." styleClass="st-label-subtitle">
                                <font><Font size="13.0" name="System Italic"/></font>
                            </Label>

                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                <Label fx:id="typeLabel" text="TIPO" styleClass="st-badge"/>
                                <Label fx:id="dateLabel" text="YYYY-MM-DD" styleClass="st-label-subtitle">
                                    <font><Font size="14.0"/></font>
                                </Label>
                                <Label text="|" styleClass="st-label-subtitle"/>
                                <Label fx:id="placeLabel" text="Luogo" styleClass="st-label-subtitle"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <Separator styleClass="st-separator"/>

                    <VBox spacing="5.0" styleClass="st-card">
                        <Label text="Dettagli Tecnici" styleClass="st-label-blue">
                            <font><Font name="System Bold" size="14.0"/></font>
                        </Label>
                        <HBox spacing="20.0">
                            <VBox spacing="2.0">
                                <Label text="Strumenti:" styleClass="st-label-subtitle"/>
                                <Label fx:id="instrumentsLabel" text="..." styleClass="st-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Label text="File Allegati e Risorse" styleClass="st-label-blue">
                        <font><Font name="System Bold" size="18.0"/></font>
                    </Label>

                    <VBox fx:id="filesContainer" spacing="10.0">
                        <Label text="Nessun file allegato." styleClass="st-label-subtitle" visible="false" fx:id="noFilesLabel"/>
                    </VBox>

                    <Separator styleClass="st-separator"/>

                    <VBox spacing="15.0" style="-fx-background-color: #1e1e24; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #333; -fx-border-radius: 8; -fx-border-width: 1;">

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Note e Segmenti dell'Esecuzione" style="-fx-text-fill: #3969da; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAddSegment" text="+ Aggiungi Nota" style="-fx-background-color: #3969da; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        </HBox>

                        <Separator style="-fx-background-color: #333; -fx-border-width: 0;" />

                        <VBox fx:id="segmentsContainer" spacing="10.0">
                        </VBox>

                    </VBox>

                    <Separator styleClass="st-separator"/>

                    <VBox spacing="10.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Commenti in Evidenza" styleClass="st-label-blue">
                                <font><Font name="System Bold" size="18.0"/></font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Vedi tutti i commenti..." styleClass="st-button-outline" style="-fx-border-color: transparent; -fx-underline: true;"/>
                        </HBox>

                        <HBox spacing="10.0" alignment="TOP_CENTER">
                            <TextArea fx:id="newCommentArea" promptText="Scrivi un commento..."
                                      prefRowCount="2" wrapText="true" HBox.hgrow="ALWAYS" styleClass="st-text-area"/>
                            <Button fx:id="btnPostComment" text="Invia" minHeight="50.0" minWidth="60.0" styleClass="st-button-primary"/>
                        </HBox>

                        <VBox fx:id="commentsContainer" spacing="15.0">
                        </VBox>
                    </VBox>

                    <Region minHeight="30.0"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>