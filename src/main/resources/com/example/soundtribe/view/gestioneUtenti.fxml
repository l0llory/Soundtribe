<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.soundtribe.controller.UsersController"
            stylesheets="@../css/style.css"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15.0" right="15.0" bottom="10.0" left="15.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <HBox spacing="5.0" alignment="CENTER_LEFT">
                        <children>
                            <Button fx:id="precP2" text="◀" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                            <Button fx:id="nextP2" text="▶" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                            <Button fx:id="backHome1" text="🏠" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                        </children>
                    </HBox>

                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="SoundTribe" styleClass="st-label-title">
                                <font>
                                    <Font name="System Bold" size="22.0"/>
                                </font>
                            </Label>
                            <Label text="Gestione collezione musicale" styleClass="st-label-subtitle">
                                <font>
                                    <Font size="11.0"/>
                                </font>
                            </Label>
                        </children>
                        <HBox.margin>
                            <Insets left="15.0"/>
                        </HBox.margin>
                    </VBox>

                    <Button fx:id="Exit2" text="Esci" minWidth="70.0" minHeight="30.0" styleClass="st-button-outline">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </Button>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets top="8.0" bottom="5.0"/>
                </padding>
                <children>
                    <Label text="Gestione Utenti" styleClass="st-label-blue">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>
                    <HBox HBox.hgrow="ALWAYS"/>
                </children>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="5.0"/>
                </padding>
                <children>
                    <TextField fx:id="barraRicerca" promptText="Cerca per nome o email..."
                               prefWidth="350.0" minHeight="30.0" HBox.hgrow="ALWAYS" styleClass="st-text-field">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </TextField>

                    <ComboBox fx:id="tuttiRuoli" promptText="Tutti i ruoli" prefWidth="150.0" minHeight="30.0" styleClass="st-combo-box"/>
                    <ComboBox fx:id="tuttiStati" promptText="Tutti gli stati" prefWidth="150.0" minHeight="30.0" styleClass="st-combo-box"/>
                </children>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="10.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <VBox spacing="5.0" VBox.vgrow="NEVER" style="-fx-background-color: transparent;">
                <children>
                    <Label fx:id="labelRichiesteSospeso" text="Richieste in sospeso" styleClass="st-label-subtitle">
                        <font>
                            <Font size="13.0"/>
                        </font>
                        <VBox.margin>
                            <Insets bottom="3.0"/>
                        </VBox.margin>
                    </Label>
                    <ListView fx:id="richiesteSospeso" prefHeight="120.0" maxHeight="150.0" styleClass="st-list-view"/>
                </children>
            </VBox>

            <VBox spacing="5.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <children>
                    <Label text="Tutti gli utenti" styleClass="st-label-subtitle">
                        <font>
                            <Font size="13.0"/>
                        </font>
                        <VBox.margin>
                            <Insets bottom="3.0"/>
                        </VBox.margin>
                    </Label>
                    <ListView fx:id="listaUtenti" VBox.vgrow="ALWAYS" styleClass="st-list-view"/>
                </children>
            </VBox>
        </VBox>
    </center>

</BorderPane>