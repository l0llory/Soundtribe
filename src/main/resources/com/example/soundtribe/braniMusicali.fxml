<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.soundtribe.SongsController"
            stylesheets="@css/style.css"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15.0" right="15.0" bottom="10.0" left="15.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <HBox spacing="5.0" alignment="CENTER_LEFT">
                        <children>
                            <Button fx:id="precP_Songs" text="◀" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                            <Button fx:id="nextP_Songs" text="▶" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                            <Button fx:id="backHome_Songs" text="🏠" minWidth="40.0" minHeight="30.0" styleClass="st-button-outline"/>
                        </children>
                    </HBox>

                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="SoundTribe" styleClass="st-label-title">
                                <font>
                                    <Font name="System Bold" size="22.0"/>
                                </font>
                            </Label>
                            <Label text="Gestione collezione musicale" styleClass="st-label-subtitle">
                                <font>
                                    <Font size="11.0"/>
                                </font>
                            </Label>
                        </children>
                        <HBox.margin>
                            <Insets left="15.0"/>
                        </HBox.margin>
                    </VBox>

                    <Button fx:id="Exit_Songs" text="Esci" minWidth="70.0" minHeight="30.0" styleClass="st-button-outline">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </Button>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets top="8.0" bottom="5.0"/>
                </padding>
                <children>
                    <Label text="Brani Musicali" styleClass="st-label-blue">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="aggiungiBrano" text="+ Aggiungi Brano" minWidth="130.0" minHeight="32.0" styleClass="st-button-primary">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </Button>
                </children>
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="5.0"/>
                </padding>
                <children>
                    <TextField fx:id="searchBarSongs" promptText="Cerca per titolo o autore..."
                               prefWidth="350.0" minHeight="30.0" HBox.hgrow="ALWAYS" styleClass="st-text-field">
                        <font>
                            <Font size="13.0"/>
                        </font>
                    </TextField>
                    <ComboBox fx:id="generiFilter" promptText="Tutti i generi" prefWidth="150.0" minHeight="30.0" styleClass="st-combo-box">
                        <padding>
                            <Insets top="2.0" bottom="2.0"/>
                        </padding>
                    </ComboBox>
                </children>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <children>
                    <Label text="Lista Brani" styleClass="st-label-subtitle">
                        <font>
                            <Font size="13.0"/>
                        </font>
                        <VBox.margin>
                            <Insets bottom="3.0"/>
                        </VBox.margin>
                    </Label>
                    <ListView fx:id="listaBrani" VBox.vgrow="ALWAYS" styleClass="st-list-view"/>
                </children>
            </VBox>
        </VBox>
    </center>

</BorderPane>